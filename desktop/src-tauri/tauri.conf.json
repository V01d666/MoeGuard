{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoeGuard Workshop Dev",
  "version": "0.6.0",
  "identifier": "com.moeguard.workshop.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label": "workshop", "title": "萌卫 · 桌宠工坊", "width": 1120, "height": 720, "minWidth": 1000, "minHeight": 650, "dragDropEnabled": false}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["workshop", "settings"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../resources/icons/moeguard.ico", "../../resources/icons/moeguard-companion.png"]
  }
}
